# Finquanta Web — environment variables
#
# Copy this file to `.env.local` and fill in the values you have. Missing
# variables trigger the dev fallbacks documented in `lib/env.ts` — the app
# continues to work; it just logs outbound calls to the console and accepts
# the mock OTP `123456`.

# ---------------------------------------------------------------------------
# Site basics
# ---------------------------------------------------------------------------
# Public URL of the deployed site. Used for canonical links, OG, etc.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# reCAPTCHA v3 (Google)
# ---------------------------------------------------------------------------
# Site key (public) and secret (server-only). Get from
# https://www.google.com/recaptcha/admin/create.
# If either is unset, reCAPTCHA verification is skipped (dev default).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Minimum score (0.0 – 1.0) to accept a submission. Google recommends 0.5.
RECAPTCHA_MIN_SCORE=0.5

# ---------------------------------------------------------------------------
# SMS / OTP (MSG91)
# ---------------------------------------------------------------------------
# MSG91 Authkey + OTP template ID. If either is unset, OTP verification
# falls back to the mock "123456" flow so dev works offline.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# Sender ID / source address (6 chars, alpha-only as per DLT).
MSG91_SENDER_ID=FINQTA

# ---------------------------------------------------------------------------
# Transactional email (Resend)
# ---------------------------------------------------------------------------
# API key from https://resend.com/api-keys. If unset, lead-notification
# emails are logged to the server console instead of sent.
RESEND_API_KEY=
# Email address leads are forwarded to. Comma-separated list OK.
LEAD_NOTIFY_TO=sandiputekar.tally@gmail.com
# From address on outbound email. Must be a verified Resend sender.
LEAD_FROM_EMAIL=website@finquanta.example

# ---------------------------------------------------------------------------
# Newsletter (Mailchimp)
# ---------------------------------------------------------------------------
# Mailchimp API key + audience (list) ID. If either unset, subscriptions
# are logged to the server console.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
# Data-centre suffix from your Mailchimp account (e.g. "us12" — read off
# the last part of the login URL).
MAILCHIMP_DC=us1

# ---------------------------------------------------------------------------
# Security — HMAC signing secret for stateless lead sessions.
# ---------------------------------------------------------------------------
# 32+ character random string. If unset, a dev-only fallback is used
# (so builds don't break); set a real secret before staging / prod deploy.
LEAD_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# Rate limiting (in-memory, single-server only — see STATUS.md for Redis note)
# ---------------------------------------------------------------------------
# Requests allowed per IP per window.
RATE_LIMIT_MAX=8
# Window length in seconds.
RATE_LIMIT_WINDOW=60

# ---------------------------------------------------------------------------
# Analytics — Google Tag Manager (SP6)
# ---------------------------------------------------------------------------
# GTM container id (e.g. `GTM-XXXXXXX`). GTM can fan out to GA4, Meta Pixel,
# LinkedIn Insight, etc. without further code changes here. If unset, no
# analytics scripts are loaded.
NEXT_PUBLIC_GTM_ID=

# Where the home-page animation frames are served from (lib/frames.ts).
# Default: /frames (public/frames). For a CDN, upload public/frames as-is and
# set the folder URL here, without a trailing slash. The CDN must allow CORS.
NEXT_PUBLIC_FRAMES_BASE=
